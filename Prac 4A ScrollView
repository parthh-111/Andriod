<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="409dp"
        android:layout_height="729dp"
        tools:layout_editor_absoluteX="1dp"
        tools:layout_editor_absoluteY="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Student Registration Form"
                    android:textAlignment="center"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editTextText"
                    android:layout_width="392dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="Enter Full Name" />

                <EditText
                    android:id="@+id/editTextText2"
                    android:layout_width="390dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="Enetr Email" />

                <EditText
                    android:id="@+id/editTextText3"
                    android:layout_width="388dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="Enetr Mobile Number" />

                <EditText
                    android:id="@+id/editTextText4"
                    android:layout_width="387dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="Enter Address" />

                <EditText
                    android:id="@+id/editTextText5"
                    android:layout_width="387dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="Enetr City" />

                <EditText
                    android:id="@+id/editTextText6"
                    android:layout_width="387dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="Enter State" />

                <EditText
                    android:id="@+id/editTextText7"
                    android:layout_width="386dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="Enter Country" />

                <EditText
                    android:id="@+id/editTextText8"
                    android:layout_width="387dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="Enter Qulification" />

                <EditText
                    android:id="@+id/editTextText9"
                    android:layout_width="387dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="X percentage" />

                <EditText
                    android:id="@+id/editTextText10"
                    android:layout_width="388dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="Enter Experience" />

                <EditText
                    android:id="@+id/editTextText11"
                    android:layout_width="388dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="Enter Country" />

                <EditText
                    android:id="@+id/editTextText12"
                    android:layout_width="384dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="XII percentage" />

                <EditText
                    android:id="@+id/editTextText13"
                    android:layout_width="387dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="School Name" />

                <EditText
                    android:id="@+id/editTextText14"
                    android:layout_width="387dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="College Name" />

                <EditText
                    android:id="@+id/editTextText15"
                    android:layout_width="387dp"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:paddingTop="25dp"
                    android:text="Father Name" />

                <Button
                    android:id="@+id/button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Submit" />

                <Button
                    android:id="@+id/button2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reset" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
